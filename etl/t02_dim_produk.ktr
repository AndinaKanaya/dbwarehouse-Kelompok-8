    <connection>dw_kelompok_8</connection>
    <sql>WITH titik AS (
  SELECT productid, startdate::date AS d FROM stg_productcosthistory
  UNION
  SELECT productid, startdate::date FROM stg_productlistpricehistory
),
periode AS (
  SELECT productid,
         d AS berlaku_mulai,
         COALESCE(LEAD(d) OVER (PARTITION BY productid ORDER BY d) - 1,
                  DATE '9999-12-31') AS berlaku_sampai
  FROM titik
),
versi AS (
  SELECT pr.productid, pr.berlaku_mulai, pr.berlaku_sampai,
         COALESCE(ch.standardcost, p.standardcost) AS biaya_standar,
         COALESCE(lh.listprice,    p.listprice)    AS harga_jual
  FROM periode pr
  JOIN stg_product p ON p.productid = pr.productid
  LEFT JOIN stg_productcosthistory ch
         ON ch.productid = pr.productid
        AND pr.berlaku_mulai BETWEEN ch.startdate::date
                                 AND COALESCE(ch.enddate::date, DATE '9999-12-31')
  LEFT JOIN stg_productlistpricehistory lh
         ON lh.productid = pr.productid
        AND pr.berlaku_mulai BETWEEN lh.startdate::date
                                 AND COALESCE(lh.enddate::date, DATE '9999-12-31')
  UNION ALL
  SELECT p.productid, p.sellstartdate::date, DATE '9999-12-31',
         p.standardcost, p.listprice
  FROM stg_product p
  WHERE NOT EXISTS (SELECT 1 FROM titik t WHERE t.productid = p.productid)
)
SELECT v.productid                          AS produk_id,
       p.name                               AS nama_produk,
       p.productnumber                      AS nomor_produk,
       COALESCE(p.color, 'Tidak ada')       AS warna,
       COALESCE(sc.name, 'Tanpa kategori')  AS subkategori,
       COALESCE(c.name,  'Tanpa kategori')  AS kategori,
       v.biaya_standar,
       v.harga_jual,
       CASE WHEN v.productid IN (SELECT productid FROM titik)
             AND v.berlaku_mulai = MIN(v.berlaku_mulai) OVER (PARTITION BY v.productid)
            THEN DATE '1900-01-01'
            ELSE v.berlaku_mulai END        AS berlaku_mulai,
       v.berlaku_sampai,
       (v.berlaku_sampai = DATE '9999-12-31') AS is_current
FROM versi v
JOIN stg_product p ON p.productid = v.productid
LEFT JOIN stg_productsubcategory sc ON sc.productsubcategoryid = p.productsubcategoryid
LEFT JOIN stg_productcategory c     ON c.productcategoryid = sc.productcategoryid;</sql>
