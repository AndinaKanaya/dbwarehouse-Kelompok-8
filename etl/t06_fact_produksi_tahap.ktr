    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>dw_kelompok_8</connection>
    <sql>SELECT r.workorderid AS workorder_id,
       r.operationsequence AS operation_sequence,
       r.locationid,
       w.productid,
       w.startdate::date AS tgl_mulai_wo,
       to_char(r.scheduledstartdate, 'YYYYMMDD')::int AS key_jadwal_mulai,
       to_char(r.scheduledenddate,   'YYYYMMDD')::int AS key_jadwal_selesai,
       to_char(r.actualstartdate,    'YYYYMMDD')::int AS key_aktual_mulai,
       to_char(r.actualenddate,      'YYYYMMDD')::int AS key_aktual_selesai,
       COALESCE(r.actualresourcehrs, 0) AS jam_sumber_daya_aktual,
       COALESCE(r.plannedcost, 0)       AS biaya_rencana,
       COALESCE(r.actualcost, 0)        AS biaya_aktual,
       (r.actualcost - r.plannedcost)   AS selisih_biaya,
       (r.actualenddate::date - r.actualstartdate::date)    AS durasi_aktual_hari,
       (r.actualenddate::date - r.scheduledenddate::date)   AS selisih_jadwal_hari
FROM stg_workorderrouting r
JOIN stg_workorder w ON w.workorderid = r.workorderid;</sql>
    <limit>0</limit>
